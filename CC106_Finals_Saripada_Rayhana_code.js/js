// =======================
// Appointment Class
// =======================
class Appointment {
  constructor(id, studentName, date, time, concern) {
    this.id = id;
    this.studentName = studentName;
    this.date = date;
    this.time = time;
    this.concern = concern;
  }
}

// =======================
// Appointment Factory
// =======================
class AppointmentFactory {
  static createAppointment(type, id, studentName, date, time, concern) {
    return new Appointment(id, studentName, date, time, concern, type);
  }
}

// =======================
// Appointment Manager (Singleton)
// =======================
class AppointmentManager {
  constructor() {
    if (AppointmentManager.instance) {
      return AppointmentManager.instance;
    }

    this.appointments = [];
    AppointmentManager.instance = this;
  }

  addAppointment(appointment) {
    this.appointments.push(appointment);
  }

  updateAppointment(id, updatedData) {
    const appt = this.appointments.find(a => a.id === id);
    if (appt) Object.assign(appt, updatedData);
  }

  deleteAppointment(id) {
    this.appointments = this.appointments.filter(a => a.id !== id);
  }

  searchAppointment(name) {
    return this.appointments.filter(a =>
      a.studentName.toLowerCase().includes(name.toLowerCase())
    );
  }

  getAll() {
    return this.appointments;
  }
}

// =======================
// TEST CODE (USAGE)
// =======================

const manager = new AppointmentManager();

const a1 = new Appointment(1, "Juan Dela Cruz", "2026-05-20", "10:00 AM", "Math Consultation");
const a2 = new Appointment(2, "Maria Santos", "2026-05-21", "1:00 PM", "Thesis Guidance");

manager.addAppointment(a1);
manager.addAppointment(a2);

console.log("All Appointments:", manager.getAll());

manager.updateAppointment(1, { time: "11:00 AM" });

console.log("Search Result:", manager.searchAppointment("Juan"));